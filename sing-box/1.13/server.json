{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true,
    "output": "/var/log/sing-box.log"
  },
  "dns": {
    "servers": [
      {
        "type": "tls",
        "tag": "nameserver",
        "server": "8.8.8.8",
        "server_port": 853
      },
      {
        "type": "https",
        "tag": "cf-dns",
        "server": "cloudflare-dns.com",
        "server_port": 443,
        "path": "/dns-query",
        "domain_resolver": "nameserver"
      }
    ],
    "final": "cf-dns"
  },
  "inbounds": [],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "default_domain_resolver": "nameserver",
    "final": "direct"
  }
}
