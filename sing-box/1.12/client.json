{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "disabled": false,
    "level": "warning",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "tls",
        "tag": "nameserver",
        "server": "223.5.5.5",
        "server_port": 853
      },
      {
        "type": "https",
        "tag": "ali-dns",
        "server": "dns.alidns.com",
        "server_port": 443,
        "path": "/dns-query",
        "domain_resolver": "nameserver"
      },
      {
        "type": "https",
        "tag": "cf-dns",
        "server": "cloudflare-dns.com",
        "server_port": 443,
        "path": "/dns-query",
        "domain_resolver": "nameserver",
        "detour": "节点选择"
      }
    ],
    "rules": [
      {
        "rule_set": "geosite-category-ads-all",
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite-connectivity-check",
          "geosite-category-ntp",
          "geosite-private",
          "geosite-tracker",
          "geosite-category-games",
          "geosite-cn"
        ],
        "server": "ali-dns"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "server": "cf-dns"
      },
      {
        "clash_mode": "direct",
        "server": "ali-dns"
      },
      {
        "clash_mode": "global",
        "server": "cf-dns"
      }
    ],
    "final": "ali-dns",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "interface_name": "sing-box",
      "address": ["172.31.0.1/30", "fdfe:dcba:9876::1/126"],
      "auto_route": false,
      "auto_redirect": false
    },
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "0.0.0.0",
      "listen_port": 1053
    },
    {
      "type": "http",
      "tag": "http-in",
      "listen": "0.0.0.0",
      "listen_port": 7890
    },
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "0.0.0.0",
      "listen_port": 7891
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "0.0.0.0",
      "listen_port": 7892
    },
    {
      "type": "redirect",
      "tag": "redirect-in",
      "listen": "0.0.0.0",
      "listen_port": 7893
    },
    {
      "type": "tproxy",
      "tag": "tproxy-in",
      "listen": "0.0.0.0",
      "listen_port": 7894
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    },
    {
      "type": "selector",
      "tag": "节点选择",
      "outbounds": ["自动切换", "手动切换"]
    },
    {
      "type": "urltest",
      "tag": "自动切换",
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 50,
      "outbounds": ["direct"]
    },
    {
      "type": "selector",
      "tag": "手动切换",
      "outbounds": ["direct"]
    },
    {
      "type": "selector",
      "tag": "游戏平台",
      "outbounds": ["direct", "节点选择"]
    },
    {
      "type": "selector",
      "tag": "漏网之鱼",
      "outbounds": ["节点选择", "direct"]
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",

